# Pin of PyPI package baked into the image (build-arg)
AWX_MCP_VERSION=1.2.0

# Runtime mode for compose: http (remote) or stdio (Cursor MCP)
MODE=http
AWX_MCP_PORT=8000

# AWX / AAP target (package expects AWX_BASE_URL)
AWX_BASE_URL=https://automation-orchestrator-test1.mystack.cloud
AWX_USERNAME=mystack-delivery-agent
AWX_PASSWORD=
# Prefer token over password when available:
# AWX_TOKEN=

AWX_PLATFORM=awx
AWX_VERIFY_SSL=true
LOG_LEVEL=info

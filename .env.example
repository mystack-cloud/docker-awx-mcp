# Pin of PyPI package baked into the image (build-arg)
AWX_MCP_VERSION=1.2.0

# Runtime mode: http-restricted (default compose), http, or stdio
MODE=http-restricted
AWX_MCP_PORT=8000

# Client API key required in http-restricted mode (send as X-API-Key)
AWX_MCP_API_KEY=dev-local-awx-mcp-key

# AWX / AAP target (package expects AWX_BASE_URL)
AWX_BASE_URL=https://automation-orchestrator-test1.mystack.cloud
AWX_USERNAME=mystack-delivery-agent
AWX_PASSWORD=
# Prefer token over password when available:
# AWX_TOKEN=

AWX_PLATFORM=awx
AWX_VERIFY_SSL=true
LOG_LEVEL=info
